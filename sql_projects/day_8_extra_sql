SELECT
  category,
  SUM(CASE WHEN amount >= 200 THEN amount ELSE 0 END) AS high_value_revenue,
  COUNT(CASE WHEN amount >= 200 THEN 1 END) AS high_value_transactions
FROM transactions
GROUP BY category;


